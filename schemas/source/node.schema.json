{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myriad-atlas.dev/schemas/source/node.schema.json",
  "title": "Knowledge source node frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "domain_id", "course_id", "summary", "takeaways"],
  "properties": {
    "id": { "type": "string", "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*|qa-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3}))$" },
    "title": { "$ref": "#/$defs/trimmedText" },
    "domain_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "course_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "summary": { "$ref": "#/$defs/trimmedText" },
    "takeaways": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/trimmedText" } },
    "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/trimmedText" } },
    "prerequisites": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "related": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "self_check": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["question", "answer"], "properties": { "question": { "$ref": "#/$defs/trimmedText" }, "answer": { "$ref": "#/$defs/trimmedText" } } } },
    "qa": { "type": "object", "additionalProperties": false, "required": ["chain_id", "root_node_id", "parent_node_id", "source_content_version", "prompt"], "properties": { "chain_id": { "$ref": "#/$defs/trimmedText" }, "root_node_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "parent_node_id": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "source_content_version": { "$ref": "#/$defs/trimmedText" }, "prompt": { "$ref": "#/$defs/trimmedText" } } }
  },
  "$defs": { "trimmedText": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" } }
}
