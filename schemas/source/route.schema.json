{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myriad-atlas.dev/schemas/source/route.schema.json",
  "title": "Knowledge route source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "name", "summary", "stages"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "code": { "type": "string", "pattern": "^[A-Z0-9]{2,8}$" },
    "name": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "summary", "modules"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "summary": { "$ref": "#/$defs/text" },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "summary", "units"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "$ref": "#/$defs/text" },
                "summary": { "$ref": "#/$defs/text" },
                "units": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["node_id", "role", "order"],
                    "properties": {
                      "node_id": { "$ref": "#/$defs/id" },
                      "role": { "enum": ["core", "optional", "anchor"] },
                      "order": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "text": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" } }
}
