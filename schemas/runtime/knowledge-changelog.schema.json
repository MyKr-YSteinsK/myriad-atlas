{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myriad-atlas.dev/schemas/runtime/knowledge-changelog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "current_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "current_version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-\\d{2}$" },
    "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["version", "date", "summary", "categories", "added_nodes", "modified_nodes", "deleted_nodes"], "properties": { "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-\\d{2}$" }, "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "summary": { "type": "string", "minLength": 1 }, "categories": { "type": "array", "items": { "type": "string" } }, "added_nodes": { "type": "array", "items": { "type": "string" } }, "modified_nodes": { "type": "array", "items": { "type": "string" } }, "deleted_nodes": { "type": "array", "items": { "type": "string" } } } } }
  }
}
