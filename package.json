{
  "name": "myriad-atlas",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest",
    "test:watch": "vitest",
    "build": "tsx scripts/content/build-all.ts && vite build && tsx scripts/pwa/build-sw.ts",
    "preview": "vite preview",
    "verify": "npm run lint && npm run typecheck && vitest run && npm run build",
    "content:validate": "tsx scripts/content/validate-source.ts",
    "content:build": "tsx scripts/content/build-all.ts",
    "content:fixture": "tsx scripts/dev/build-fixture-content.ts",
    "dev:fixture": "npm run content:fixture && vite",
    "content:map": "tsx scripts/content/build-knowledge-map.ts",
    "content:map:check": "tsx scripts/content/build-knowledge-map.ts --check",
    "content:reproducibility": "tsx scripts/content/check-reproducibility.ts",
    "content:new": "tsx scripts/authoring/new-content.ts",
    "batch:create": "tsx scripts/authoring/create-batch.ts",
    "update-knowledge": "tsx scripts/knowledge/update-knowledge.ts",
    "release:prepare": "tsx scripts/release/release-prepare.ts",
    "release:check": "tsx scripts/release/release-check.ts",
    "release:verify-pages": "tsx scripts/release/verify-pages.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dexie": "^4.4.4",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.23.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1"
  }
}
